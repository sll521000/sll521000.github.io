---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

// 我正在做的事情（有链接的点击直达，没链接的先展示着）
const projects = [
  {
    title: "Token 中转站",
    url: "https://www.yun-shu.top/",
    desc: "Token 中转服务，统一接入各家 AI 模型接口，稳定好用。",
  },
  {
    title: "万物成像",
    url: "https://wwdesign.cn/studio/?ref=ww-yun-shutop#/",
    desc: "万物成像项目，探索影像生成的更多可能。",
  },
  {
    title: "读书",
    url: null,
    desc: "读书笔记与思考记录，长期坚持。",
  },
];

// 联系卡片：把二维码图片放进 public/ 文件夹并命名为
// qr-wechat.png / qr-group.png / qr-group2.png（jpg/webp 也行），推送后自动显示
const contactCards = [
  { title: "微信联系", desc: "扫码加我微信", file: "qr-wechat" },
  { title: "Token 中转站交流群", desc: "扫码加入交流群", file: "qr-group" },
  { title: "Token 中转站用户群", desc: "扫码加入用户群", file: "qr-group2" },
];

const qrFiles = import.meta.glob("/public/qr-*.{png,jpg,jpeg,webp}");
function qrSrc(file: string): string | null {
  for (const ext of ["png", "jpg", "jpeg", "webp"]) {
    if (`/public/${file}.${ext}` in qrFiles) return `/${file}.${ext}`;
  }
  return null;
}
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        你好，我是麒麟
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        欢迎来到我的个人网站。这里记录我正在做的事情，以及平时的思考与读书笔记。
      </p>
      <p class="mt-2">
        欢迎交流合作，可以在下面的社交链接找到我。
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <section id="projects" class="border-border border-b pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">我正在做什么</h2>
      <ul>
        {
          projects.map(p => (
            <li class="my-6">
              {p.url ? (
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener"
                  class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline"
                >
                  <h3>{p.title} ↗</h3>
                </a>
              ) : (
                <h3 class="text-lg font-medium">{p.title}</h3>
              )}
              <p>{p.desc}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="contact" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">联系我</h2>
      <div class="grid grid-cols-1 gap-4 py-4 sm:grid-cols-3">
        {
          contactCards.map(c => {
            const src = qrSrc(c.file);
            return (
              <div class="rounded-lg border border-border p-5 text-center">
                <h3 class="text-lg font-medium">{c.title}</h3>
                {src ? (
                  <img
                    src={src}
                    width="160"
                    height="160"
                    alt={`${c.title}二维码`}
                    class="mx-auto mt-4 rounded-lg"
                  />
                ) : (
                  <div class="mx-auto mt-4 flex h-40 w-40 flex-col items-center justify-center rounded-lg border-2 border-dashed border-border text-sm opacity-60">
                    二维码
                    <br />
                    放这里
                  </div>
                )}
                <p class="mt-3 text-sm opacity-75">{c.desc}</p>
              </div>
            );
          })
        }
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      sortedPosts.length > 0 && (
        <div class="my-8 text-center">
          <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
            {t.home.allPosts}
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
